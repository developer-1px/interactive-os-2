{
  "$schema": "os-parts-selection",
  "description": "Todo 모바일 앱 Stage 3 — 요구사항을 충족하는 ui/ 기존 부품 목록. 새 부품 생성 금지, '있는 걸로 만든다' 원칙.",
  "source": "src/interactive-os/CATALOG.md",
  "layout": {
    "engine": "FlatLayout",
    "root": "definePage",
    "reason": "레이아웃 엔진 SSOT. widget=React, layout=엔진."
  },
  "parts": [
    {
      "role": "header",
      "component": "PanelHeader",
      "path": "ui/panels/Panel (혹은 ui/PanelHeader)",
      "usage": "상단 'Todo' 제목 + '완료 N / 전체 M' 진행 요약"
    },
    {
      "role": "list",
      "component": "ListBox",
      "path": "ui/ListBox",
      "usage": "Todo 항목 리스트. select 축 + activate 축 조합.",
      "pattern": "listbox"
    },
    {
      "role": "list-item",
      "component": "ListItem",
      "path": "ui/items/ListItem",
      "usage": "개별 Todo 행. 체크박스 + 텍스트 + 삭제 버튼 slot"
    },
    {
      "role": "toggle",
      "component": "Checkbox",
      "path": "ui/Checkbox",
      "usage": "완료 여부 토글. data.done 바인딩"
    },
    {
      "role": "delete",
      "component": "Button",
      "path": "ui/Button",
      "props": { "role": "icon", "size": "sm" },
      "usage": "삭제 아이콘 버튼. CloseIndicator 아이콘 slot"
    },
    {
      "role": "delete-icon",
      "component": "CloseIndicator",
      "path": "ui/indicators/CloseIndicator",
      "usage": "삭제 버튼 내부 X 아이콘"
    },
    {
      "role": "input",
      "component": "TextInput",
      "path": "ui/TextInput",
      "usage": "새 할 일 입력. Enter 키 → add command"
    },
    {
      "role": "submit",
      "component": "Button",
      "path": "ui/Button",
      "props": { "role": "primary" },
      "usage": "'추가' 버튼. TextInput 우측 배치"
    },
    {
      "role": "empty-state",
      "component": "EmptyState",
      "path": "ui/EmptyState",
      "usage": "목록 비었을 때 '할 일이 없어요' 메시지"
    }
  ],
  "commands": {
    "engine": "createCommandEngine",
    "plugins": ["history"],
    "defined": ["todo:add", "todo:toggle", "todo:remove"]
  },
  "gaps": [
    {
      "note": "PanelHeader가 '진행 요약' subtitle slot을 지원하는지 Stage 4 배치 단계에서 확인 필요. 없으면 Panel + 수동 slot."
    },
    {
      "note": "ListItem이 우측 delete 버튼 slot을 지원하는지 확인. 없으면 커스텀 renderItem 대신 items/에 새 Item 추가 검토."
    }
  ]
}

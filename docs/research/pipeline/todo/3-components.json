{
  "stage": 3,
  "name": "components",
  "description": "Stage 2 데이터를 그릴 ui/ 완성품 선언. 각 부품은 역할 1개에 대응. Stage 5 코드가 이 리스트의 component를 전부 import 해야 pipelineCheck A 검사 통과.",
  "parts": [
    {
      "role": "page-shell",
      "component": "FlatLayout",
      "path": "@os/ui/FlatLayout",
      "purpose": "split root (header / body / composer) 레이아웃 엔진. definePage 트리를 렌더"
    },
    {
      "role": "header-bar",
      "component": "PanelHeader",
      "path": "@os/ui/PanelHeader",
      "purpose": "상단 '완료 N / 전체 M' 요약 바"
    },
    {
      "role": "todo-list",
      "component": "ListBox",
      "path": "@os/ui/ListBox",
      "purpose": "NormalizedData를 data prop으로 받아 각 todo row를 renderItem slot으로 그리는 keyboard-first 리스트"
    },
    {
      "role": "empty-state",
      "component": "EmptyState",
      "path": "@os/ui/EmptyState",
      "purpose": "목록이 비었을 때 '할 일이 없어요' 메시지 + 아이콘"
    },
    {
      "role": "item-check-indicator",
      "component": "CheckIndicator",
      "path": "@os/ui/indicators/CheckIndicator",
      "purpose": "todo row 좌측 체크박스 시각 인디케이터 (done 상태를 data-checked로 표현)"
    },
    {
      "role": "item-delete-indicator",
      "component": "CloseIndicator",
      "path": "@os/ui/indicators/CloseIndicator",
      "purpose": "todo row 우측 삭제 버튼 내부 아이콘"
    },
    {
      "role": "composer-input",
      "component": "TextInput",
      "path": "@os/ui/TextInput",
      "purpose": "하단 '새 할 일...' 텍스트 입력"
    },
    {
      "role": "composer-submit",
      "component": "Button",
      "path": "@os/ui/Button",
      "purpose": "하단 '추가' submit 버튼"
    }
  ],
  "notExistingParts": [],
  "ariaPatternsUsed": [
    "listbox (via ListBox) — navigate/activate 축 자동 참여"
  ]
}

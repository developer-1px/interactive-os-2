{
  "$schema": "NormalizedData",
  "description": "Todo 모바일 앱 초기 데이터. entity.data.text는 할 일 제목, entity.data.done은 완료 여부. ROOT가 todo 목록을 children으로 가진다.",
  "entities": {
    "__root__": {
      "id": "__root__",
      "type": "root",
      "data": {}
    },
    "todo-1": {
      "id": "todo-1",
      "type": "todo",
      "data": {
        "text": "우유 사기",
        "done": false
      }
    },
    "todo-2": {
      "id": "todo-2",
      "type": "todo",
      "data": {
        "text": "세탁물 찾기",
        "done": true
      }
    },
    "todo-3": {
      "id": "todo-3",
      "type": "todo",
      "data": {
        "text": "이메일 확인",
        "done": false
      }
    }
  },
  "relationships": {
    "__root__": ["todo-1", "todo-2", "todo-3"]
  },
  "derived": {
    "progress": {
      "total": 3,
      "done": 1,
      "source": "computed from entities[type='todo'].data.done count"
    }
  },
  "commands": [
    {
      "type": "todo:add",
      "payload": { "text": "string" },
      "effect": "entities[newId] = { type:'todo', data:{ text, done:false } } + relationships.__root__.push(newId)"
    },
    {
      "type": "todo:toggle",
      "payload": { "id": "string" },
      "effect": "entities[id].data.done = !entities[id].data.done"
    },
    {
      "type": "todo:remove",
      "payload": { "id": "string" },
      "effect": "delete entities[id] + relationships.__root__ = relationships.__root__.filter(x=>x!==id)"
    }
  ]
}

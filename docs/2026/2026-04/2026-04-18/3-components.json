{
  "_comment": "Stage 3 — parts[] (ui/ 완성품 매핑) + domain_items[] (엔티티 전용 렌더 함수).",
  "parts": [
    {
      "role": "page-shell",
      "component": "FlatLayout",
      "usage": "src/pages/todo/PageTodo.tsx — definePage 구조를 widget registry와 조립"
    },
    {
      "role": "header",
      "component": "PanelHeader",
      "usage": "TodoHeaderWidget — 앱 이름 + 완료 N/M 요약"
    },
    {
      "role": "list",
      "component": "ListBox",
      "usage": "TodoListWidget — NormalizedData data prop + renderItem={TodoItem}"
    },
    {
      "role": "empty",
      "component": "EmptyState",
      "usage": "TodoListWidget — 리스트가 비었을 때 안내 메시지"
    },
    {
      "role": "composer",
      "component": "Composer",
      "usage": "TodoComposerWidget — 새 할 일 텍스트 입력 + Enter 제출"
    }
  ],
  "domain_items": [
    {
      "name": "TodoItem",
      "path": "src/entities/todo/ui/TodoItem.tsx",
      "consumed_by": "ListBox.renderItem",
      "reason": "data.done=true이면 회색 + text-decoration:line-through (module.css last-mile)"
    }
  ]
}

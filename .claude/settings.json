{
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "plugin-repo@plugins": true
  },
  "extraKnownMarketplaces": {
    "plugins": {
      "source": {
        "source": "settings",
        "name": "plugins",
        "plugins": [
          {
            "name": "plugin-repo",
            "source": {
              "source": "github",
              "repo": "developer-1px/plugin-repo"
            }
          }
        ],
        "owner": {
          "name": "REDACTED"
        }
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/detectHandoff.mjs",
            "timeout": 3000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [{
          "type": "command",
          "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/skillEvent.mjs start",
          "timeout": 3000,
          "async": true
        }]
      },
      {
        "matcher": "Bash",
        "if": "Bash(git *)",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/guardBash.mjs",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/guardFilename.mjs",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "if": "Write(*.tsx)|Write(*.ts)|Write(*.jsx)|Edit(*.tsx)|Edit(*.ts)|Edit(*.jsx)",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/guardOsPatterns.mjs",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "if": "Write(*.css)|Edit(*.css)",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/guardCssAxes.mjs",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "if": "Write(*.tsx)|Write(*.ts)|Edit(*.tsx)|Edit(*.ts)",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/guardAxCombinations.mjs",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/guardCodePatterns.mjs",
            "timeout": 3000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [{
          "type": "command",
          "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/skillEvent.mjs end",
          "timeout": 3000,
          "async": true
        }]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/logAgentOps.mjs",
            "timeout": 5000,
            "async": true
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/checkDesignTokens.mjs",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/checkTestComponents.mjs",
            "timeout": 5000,
            "statusMessage": "Checking test components..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/checkDesignScore.mjs",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/checkFileSize.mjs",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/checkSwitchComplexity.mjs",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/checkTypecheck.mjs",
            "timeout": 15000,
            "async": true,
            "statusMessage": "Type checking..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/stopTestGate.mjs",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
